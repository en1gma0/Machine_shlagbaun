# Скопируйте этот файл в .env и впишите свои данные.
SITE_NAME=Шлагбаум

# ===== Камеры =====
# DIRECTION: auto = по истории (машина внутри -> выезд); entry / exit = камера только на въезде / выезде
# ROI = зона поиска номера x1,y1,x2,y2 в долях кадра (удобнее задать на странице «Настройки»)
# SCALE = увеличение зоны перед распознаванием (2 помогает, когда номер мелкий)
# Для Hikvision: /Streaming/Channels/101 = основной поток (нужен он), 102 = дополнительный (слишком мал)
CAMERA1_URL=rtsp://LOGIN:PASSWORD@192.0.2.10:554/Streaming/Channels/101
CAMERA1_NAME=Въезд
CAMERA1_DIRECTION=auto
CAMERA1_ROI=
CAMERA1_SCALE=1
# веб-порт камеры (для кнопки «Перезагрузить камеру» и канала событий)
CAMERA1_HTTP_PORT=80
# 1 = слушать события камеры Hikvision (AcuSense: пересечение линии транспортом) и записывать проезд,
#     даже если номер не прочитался. В камере нужно включить «Пересечение линии» с целью «Транспорт».
CAMERA1_ACUSENSE=0

# Вторая камера (необязательно)
#CAMERA2_URL=rtsp://LOGIN:PASSWORD@192.0.2.11:554/Streaming/Channels/101
#CAMERA2_NAME=Выезд
#CAMERA2_DIRECTION=auto
#CAMERA2_ROI=
#CAMERA2_SCALE=1

# ===== Распознавание =====
MIN_OCR_CONF=0.6
CONFIRM_HITS=2
COOLDOWN_SEC=60
DETECTOR_CONF=0.3
# Узбекские номера: 01A123BC (частные) и 01123ABC (юрлица). Пусто = любой формат
PLATE_REGEX=^(\d{2}[A-Z]\d{3}[A-Z]{2}|\d{5}[A-Z]{3})$
# 1 = в белом списке прощается одна ошибка распознавания
WHITELIST_MAX_DISTANCE=0
# повторный въезд без выезда: warn = пометить в журнале, deny = не пускать, off = не проверять
ANTIPASSBACK=warn

# ===== Шлагбаум =====
# none = только журнал; hikvision = реле (тревожный выход) камеры; http = запрос на URL контроллера
GATE_MODE=none
GATE_PULSE_SEC=1
GATE_HIK_HOST=
GATE_HIK_USER=
GATE_HIK_PASSWORD=
GATE_HIK_OUTPUT=1
GATE_HTTP_URL=
GATE_HTTP_METHOD=GET
EXIT_OPEN_ALL=true

# ===== Веб-интерфейс =====
# Пользователи и пароли создаются на сайте: при первом запуске - администратор, потом страница «Пользователи».
WEB_PORT=8000
# сколько дней помнить вход
SESSION_DAYS=14

# ===== Обслуживание =====
# фото проездов старше стольких дней удаляются (0 = хранить всегда)
SNAP_KEEP_DAYS=90
# папка резервных копий базы (лучше на другом диске), сколько копий хранить, в котором часу делать
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_HOUR=3

# ===== Мониторинг =====
# камера без видео дольше стольких минут - тревога; свободного места меньше стольких ГБ - тревога
CAMERA_ALERT_MIN=3
DISK_MIN_GB=5
# необязательно: уведомления о тревогах в Telegram (бот от @BotFather и id чата)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
