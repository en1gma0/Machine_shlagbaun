# ===== Приватные данные: никогда не отправлять в git =====

# Настройки с адресами камер, логинами и паролями
.env
.env.*
!.env.example
*.env

# База (белый список, журнал проездов), фото машин и номеров, логи
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
snaps/
*.log

# Выгрузки: Excel-отчёты, белые списки, наборы для обучения с фото номеров
*.xlsx
*.xls
*.csv
dataset_*.zip
*.zip

# Фото и видео с камер (снимки, записи для проверки)
*.jpg
*.jpeg
*.png
*.webp
*.mp4
*.avi
*.mkv

# Ключи и сертификаты (если появится HTTPS)
*.pem
*.key
*.crt
*.pfx

# ===== Служебное =====

# Python
.venv/
venv/
__pycache__/
*.py[cod]

# Скачанная утилита для службы Windows
nssm.exe

# Редакторы и система
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store
